# command = /usr/bin/zsh

theme = Dracula
# font-family = "CaskaydiaMono Nerd Font" 
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# --- Window Styling ---
# Adds some breathing room around the edges of the terminal
window-padding-x = 10
window-padding-y = 10

# Hide the window titlebar for a cleaner look
window-decoration = false


window-width = 149
window-height = 33

# background-opacity = 0.96
# background-blur = 20
